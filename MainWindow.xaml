<Window x:Class="Lab2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Person Form" Height="365" Width="350">

    <Grid Background="Pink">
        <StackPanel Margin="20">

            <TextBlock Text="Ім'я:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Padding="5" />

            <TextBlock Text="Прізвище:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,10,5"/>
            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Email:" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <TextBlock Text="Дата народження (дд.мм.рррр):" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,10,0,5"/>
            <TextBox Text="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>

            <Button Content="Proceed" 
                    Command="{Binding ProceedCommand}"
                    FontSize="15"
                    FontWeight="Bold"
                    Padding="2"
                    Margin="20,15,20,0"
                    BorderThickness="0"
                    Cursor="Hand"
                    Width="150"
                    HorizontalAlignment="Center"
                    Height="30"
                    IsEnabled="{Binding CanProceed}">

                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF8DA1"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Opacity" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
